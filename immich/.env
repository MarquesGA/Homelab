# Local onde os arquivos enviados serão armazenados
UPLOAD_LOCATION=/caminho/para/uploads   # ← Substitua pelo caminho real

# Local onde os arquivos do banco de dados serão armazenados
DB_DATA_LOCATION=/caminho/para/postgres # ← Substitua pelo caminho real

# Timezone (opcional)
# TZ=America/Sao_Paulo

# Versão do Immich
IMMICH_VERSION=release                   # ← ou fixe uma versão, ex: v1.71.0

# Senha do banco de dados (mantenha secreta!)
DB_PASSWORD=<SUA_SENHA_AQUI>            # ← substitua por senha forte

# Valores padrão do banco de dados (não precisam alterar)
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
